+                except Exception:                  # noqa: BLE001
+                    continue
+                lo, hi = self.RANGES.get(k, (-1e9, 1e9))
+                v = min(hi, max(lo, v))
+            if self.params.get(k) != v:
+                self.params[k] = v
+                changed.append(f"{k}={v}")
+        self.det.cfg = dict(self.params)
+        return changed
