+def test_side():
+    print("--- 5. 小刻みステップ: 横 0.5m / 右へ5cm / 後ろへ10cm / 1歩 / 歩かないときの中止 ---")
+    robot, tk, wc = _setup([dict(x=3.0, y=0.0, w=4.0, d=0.2, h=1.0)],
