# G1 オンボード演算コックピット(HTTP :8090)。機体の起動時に自動で立ち上がる。
# 配置: /etc/systemd/system/g1-cockpit.service   (real/install_autostart.sh が入れる)
#
# ★起動時は IDLE(何も送らない)。lowcmd は操作者が制御権を取るまで出ない。
# ★3f_demo.service(他社デモ、rt/lowcmd を出せる)は enabled のまま毎回止める(disable しない)。
#   Conflicts= は使わない: 起動時に両方が同じトランザクションへ入ると、どちらが落ちるか
#   systemd 任せになる。ここでは After= で後に並び、ExecStartPre で明示的に止める。
[Unit]
Description=G1 onboard cockpit (HTTP :8090)
After=network-online.target g1-lidar-bridge.service 3f_demo.service
Wants=network-online.target g1-lidar-bridge.service

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/cl-workspace/g1_cockpit/real
# MUJOCO_GL=disable が必須(機体に GL 環境が無く EGL 初期化で落ちる。FK にしか使わない)
Environment=HOME=/home/unitree MUJOCO_GL=disable PYTHONUNBUFFERED=1
# ★ログインシェル(~/.bashrc)と同じ DDS の設定。無いと cyclonedds が既定設定で動く(2026-09-04 午後に判明)
Environment=CYCLONEDDS_URI=/home/unitree/cyclonedds_ws/cyclonedds.xml RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda-11.4/lib64
LimitNOFILE=8192
Nice=-5
# 1) 競合する lowcmd 送信源を止める(+ は root で実行)
ExecStartPre=+/bin/bash -c 'systemctl stop 3f_demo.service 2>/dev/null || true'
# 1b) CPU/GPU/EMC クロックを最大に固定(root)。既定の schedutil は 729MHz でアイドルし、方策開始直後の
#     推論が遅れて「制御周期が遅い」ガードで止まる(2026-09-04 12:36 の 2 本)。再起動で戻るのでここで毎回
ExecStartPre=-+/usr/bin/jetson_clocks
# 2) eth0 に 192.168.123.x が付くまで待つ(最長2分)
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ip -4 addr show eth0 2>/dev/null | grep -q "inet 192\\.168\\.123\\." && exit 0; sleep 2; done; echo "eth0 に 192.168.123.x が付かない"; exit 1'
# 3) 手動起動の取り残し(nohup の cockpit.py)が居たら止める
ExecStartPre=/bin/bash -c 'pkill -f "python3 -u cockpit\\.py" 2>/dev/null; sleep 1; exit 0'
# 時刻が合うまで待つ(Jetson は RTC 電池なしで起動直後は 1970 年。ログの日時と走行ログの名前が狂う)。最長 60 秒
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ "$(date +%%Y)" -ge 2024 ] && exit 0; sleep 1; done; echo "時刻が同期しない(1970のまま起動)"; exit 0'
ExecStartPre=/bin/bash -c ': > /home/unitree/cl-workspace/cockpit_onboard.log'
ExecStart=/usr/bin/python3 -u /home/unitree/cl-workspace/g1_cockpit/real/cockpit.py --port 8090 --host 0.0.0.0
StandardOutput=append:/home/unitree/cl-workspace/cockpit_onboard.log
StandardError=inherit
# 落ちたら 15 秒後に立て直す(import torch に約45秒)
Restart=always
RestartSec=15
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
